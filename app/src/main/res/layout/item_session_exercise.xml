<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/shape_md"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Exercise image -->
        <ImageView
            android:id="@+id/imageView_exercisePhoto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/exercise_image_height"
            android:scaleType="centerCrop"
            android:contentDescription="Exercise demonstration"
            android:background="@color/surface_variant" />

        <!-- Header row: name + collapse toggle -->
        <LinearLayout
            android:id="@+id/layout_exerciseHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_md"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textView_exerciseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/imageButton_collapse"
                android:layout_width="@dimen/min_tap_target"
                android:layout_height="@dimen/min_tap_target"
                android:src="@android:drawable/arrow_up_float"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Collapse exercise" />

        </LinearLayout>

        <!-- Collapsible content -->
        <LinearLayout
            android:id="@+id/layout_exerciseContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Set row header labels -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_xs">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:text="Set"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Weight (kg)"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reps"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:gravity="center" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="1dp" />

                <View
                    android:layout_width="48dp"
                    android:layout_height="1dp" />

            </LinearLayout>

            <!-- Set rows container (dynamically added) -->
            <LinearLayout
                android:id="@+id/layout_setContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Add set button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_addSet"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="+ Add Set"
                android:textColor="@color/primary" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
