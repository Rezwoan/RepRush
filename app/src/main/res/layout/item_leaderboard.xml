<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_xs"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="@dimen/shape_md"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm">

        <!-- Rank / medal -->
        <TextView
            android:id="@+id/textView_rank"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="#1"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Avatar -->
        <ImageView
            android:id="@+id/imageView_avatar"
            android:layout_width="@dimen/avatar_sm"
            android:layout_height="@dimen/avatar_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:src="@drawable/ic_person"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop" />

        <!-- Name + PR count -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView_displayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Member"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textView_prCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PRs"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Points -->
        <TextView
            android:id="@+id/textView_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 pts"
            android:textColor="@color/points_yellow"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
