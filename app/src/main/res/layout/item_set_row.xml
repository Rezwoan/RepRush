<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_set_row"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:paddingStart="@dimen/spacing_sm"
    android:paddingEnd="@dimen/spacing_sm">

    <!-- Completion circle (left) -->
    <ImageButton
        android:id="@+id/imageButton_completeSet"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/checkbox_off_background"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Complete set" />

    <!-- Set number -->
    <TextView
        android:id="@+id/textView_setNumber"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Weight input -->
    <EditText
        android:id="@+id/editText_weight"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_xs"
        android:background="@android:color/transparent"
        android:hint="—"
        android:inputType="numberDecimal"
        android:imeOptions="actionNext"
        android:nextFocusForward="@+id/editText_reps"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- KG label -->
    <TextView
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:text="KG"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Reps input -->
    <EditText
        android:id="@+id/editText_reps"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_xs"
        android:background="@android:color/transparent"
        android:hint="—"
        android:inputType="number"
        android:imeOptions="actionDone"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_variant"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Reps label -->
    <TextView
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:text="Reps"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
