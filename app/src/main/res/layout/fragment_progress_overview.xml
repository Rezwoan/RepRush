<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Activity Heatmap (shared HeatmapViewModel) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/shape_md"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Activity"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <com.kizitonwose.calendar.view.CalendarView
                    android:id="@+id/heatmap_calendar_overview"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    app:cv_dayViewResource="@layout/item_heatmap_day"
                    app:cv_monthHeaderResource="@layout/item_heatmap_month_header"
                    app:cv_orientation="horizontal"
                    app:cv_scrollPaged="true"
                    app:cv_outDateStyle="endOfGrid"
                    app:cv_daySize="rectangle" />

                <TextView
                    android:id="@+id/text_heatmap_empty_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start training to see your workout history"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:padding="@dimen/spacing_md"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Workout History -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Workout History"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_workout_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="@dimen/spacing_md" />

        <TextView
            android:id="@+id/text_history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No workouts logged yet."
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="@dimen/spacing_md"
            android:visibility="gone" />

        <!-- Weekly Volume Per Muscle Group -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume by Muscle Group"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/chart_muscle_volume"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="@dimen/spacing_md" />

        <TextView
            android:id="@+id/text_muscle_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete workouts to see muscle group volume."
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="@dimen/spacing_md"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
